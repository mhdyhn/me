{
  "name": "meety-personal-gym-coach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node tools/compress-static.mjs",
    "benchmark:api": "node tools/benchmark-api.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:offline": "vite build --mode offline && node tools/make-single-file.mjs",
    "verify:offline": "node tools/verify-offline-bundle.mjs",
    "server": "node server/index.ts",
    "test:responsive": "playwright test --config=playwright.responsive.config.ts",
    "test:pwa-offline": "node tools/test-pwa-offline.mjs",
    "test:pwa-upgrade": "node tools/test-pwa-upgrade.mjs",
    "test:offline-file": "node tools/test-offline-file.mjs",
    "test:transfer-integration": "node tools/test-transfer-integration.mjs",
    "test:3d-qr": "node tools/test-3d-and-qr.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@electric-sql/pglite": "^0.5.9",
    "@fontsource/vazirmatn": "^5.3.0",
    "dexie": "^4.4.6",
    "ipaddr.js": "^2.5.0",
    "jalaali-js": "^2.0.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "proxy-addr": "^2.0.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/proxy-addr": "^2.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.4.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
