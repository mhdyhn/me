# Copy to .env for local development. Never put real secrets in this file.

# The hosted PostgreSQL (Supabase Free). Use the Session pooler URI with ?sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# How long a connection attempt may take. A free host wakes up slowly after an idle period.
DATABASE_CONNECT_TIMEOUT_MS=30000

# At least 16 characters. Keep it secret and stable: changing it invalidates the stored
# password hashes of the temporary codes.
MEETY_SECRET=change-me-to-a-long-random-string

# The first admin account is created with these values on an empty database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Where the web build looks for the API. Leave empty for the same origin.
VITE_API_BASE=

# نشانی فایل نصبی اندروید (اختیاری). اگر تنظیم نشود، نشانی «آخرین نسخهٔ منتشرشده» در گیت‌هاب استفاده می‌شود.
ANDROID_APK_URL=

# پرداخت کارت‌به‌کارت (اختیاری). اگر در پنل مدیر کارت ثبت شود، همین مقادیر نادیده گرفته می‌شوند.
CARD_TRANSFER_CARD_NUMBER=
CARD_TRANSFER_CARD_HOLDER=
CARD_TRANSFER_BANK_NAME=
CARD_TRANSFER_EXPIRY_HOURS=72
CARD_TRANSFER_MAX_PER_DAY=3
CARD_TRANSFER_UNIQUE_AMOUNT=on
# سرویس بررسی رسید (اختیاری). نشانی HTTPS و بدون اطلاعات کاربری؛ هر پاسخ باید {"valid": true} بدهد.
CARD_TRANSFER_VERIFY_URL=

# قیمت ماهانهٔ اشتراک (اختیاری). قیمت واقعی از پنل مدیر خوانده می‌شود؛ این فقط
# قیمتِ پلن‌هایی است که مدیر هنوز در پنل تغییر نداده است.
SUBSCRIPTION_PRICE_TOMANS=99000
# سهم مربیِ معرف از اشتراک شاگردِ معرفی‌شده (درصد).
SUBSCRIPTION_REFERRAL_PERCENT=10

# هوش مصنوعی داخلی (اختیاری). هر سرویس سازگار با OpenAI کار می‌کند.
# بدون این سه متغیر، برنامه همان متن‌های قاعده‌محور خودش را می‌نویسد و چیزی خراب نمی‌شود.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
